module(
    name = "bazel_monty_demo",
    version = "0.1.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "rules_rust", version = "0.71.3")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "monty_src",
    patch_args = ["-p1"],
    patches = ["//third_party/monty:patches/add-bazel-build-files.patch"],
    sha256 = "f185d03ab5853b32d57145edcc2011ab7b83105c70b8a938d563e7d7365ed409",
    strip_prefix = "monty-4bcbcf5251b3a4a30b22fdfc372e5189adf4b86f",
    urls = ["https://github.com/pydantic/monty/archive/4bcbcf5251b3a4a30b22fdfc372e5189adf4b86f.tar.gz"],
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.95.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")
use_repo(python, "python_3_14", "pythons_hub")

register_toolchains("@pythons_hub//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//third_party/monty:Cargo.lock",
    manifests = [
        "//third_party/monty:Cargo.toml",
    ],
)
use_repo(crate, "crates")
