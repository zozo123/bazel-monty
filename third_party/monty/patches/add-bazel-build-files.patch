diff --git a/bazel/smoke/monty_smoke_test.rs b/bazel/smoke/monty_smoke_test.rs
new file mode 100644
index 0000000..d8f597c
--- /dev/null
+++ b/bazel/smoke/monty_smoke_test.rs
@@ -0,0 +1,8 @@
+use monty::{MontyObject, MontyRun};
+
+#[test]
+fn bazel_can_run_monty_code() {
+    let runner = MontyRun::new("x + 1".to_owned(), "bazel_smoke.py", vec!["x".to_owned()]).unwrap();
+    let result = runner.run_no_limits(vec![MontyObject::Int(41)]).unwrap();
+    assert_eq!(result.as_ref(), &MontyObject::Int(42));
+}
